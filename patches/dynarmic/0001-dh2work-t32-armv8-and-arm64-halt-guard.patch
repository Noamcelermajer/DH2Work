index 6f0813ca..47b6b66d 100644
--- a/src/dynarmic/CMakeLists.txt
+++ b/src/dynarmic/CMakeLists.txt
@@ -156,6 +156,7 @@ if ("A32" IN_LIST DYNARMIC_FRONTENDS)
         frontend/A32/translate/impl/thumb32_branch.cpp
         frontend/A32/translate/impl/thumb32_control.cpp
         frontend/A32/translate/impl/thumb32_coprocessor.cpp
+        frontend/A32/translate/impl/thumb32_crc32.cpp
         frontend/A32/translate/impl/thumb32_data_processing_modified_immediate.cpp
         frontend/A32/translate/impl/thumb32_data_processing_plain_binary_immediate.cpp
         frontend/A32/translate/impl/thumb32_data_processing_register.cpp
diff --git a/src/dynarmic/backend/arm64/a32_address_space.cpp b/src/dynarmic/backend/arm64/a32_address_space.cpp
index bbdf925f..b8affb3b 100644
--- a/src/dynarmic/backend/arm64/a32_address_space.cpp
+++ b/src/dynarmic/backend/arm64/a32_address_space.cpp
@@ -166,7 +166,11 @@ IR::Block A32AddressSpace::GenerateIR(IR::LocationDescriptor descriptor) const {
 
     Optimization::PolyfillPass(ir_block, {});
     Optimization::NamingPass(ir_block);
-    if (conf.HasOptimization(OptimizationFlag::GetSetElimination)) {
+    // A data access performed with check_halt_on_memory_access can terminate this block
+    // part-way. GetSetElimination keeps guest register writes pending in the IR, so letting
+    // it run in that mode would let such a halt report pre-interpretation register values.
+    // Leave it off, matching the A64 arm64 backend and both x64 backends.
+    if (conf.HasOptimization(OptimizationFlag::GetSetElimination) && !conf.check_halt_on_memory_access) {
         Optimization::A32GetSetElimination(ir_block, {.convert_nzc_to_nz = true});
         Optimization::DeadCodeElimination(ir_block);
     }
diff --git a/src/dynarmic/frontend/A32/decoder/thumb32.inc b/src/dynarmic/frontend/A32/decoder/thumb32.inc
index ecc7a655..82464fab 100644
--- a/src/dynarmic/frontend/A32/decoder/thumb32.inc
+++ b/src/dynarmic/frontend/A32/decoder/thumb32.inc
@@ -21,6 +21,21 @@ INST(thumb32_LDRD_imm_1,     "LDRD (imm)",               "11101000U111nnnnttttss
 INST(thumb32_LDRD_imm_2,     "LDRD (imm)",               "11101001U1W1nnnnttttssssiiiiiiii")
 INST(thumb32_STL,            "STL",                      "111010001100nnnntttt111110101111") // v8
 INST(thumb32_LDA,            "LDA",                      "111010001101nnnntttt111110101111") // v8
+// ARMv8-A acquire/release and acquisition/release-exclusive accesses. These are the T32
+// encodings of the primitives that frontend/A32/translate/impl/synchronization.cpp already
+// implements for the ARM state; the exclusive forms drive the global exclusive monitor.
+INST(thumb32_LDAB,           "LDAB",                     "111010001101nnnntttt111110001111") // v8
+INST(thumb32_LDAH,           "LDAH",                     "111010001101nnnntttt111110011111") // v8
+INST(thumb32_LDAEX,          "LDAEX",                    "111010001101nnnntttt111111101111") // v8
+INST(thumb32_LDAEXB,         "LDAEXB",                   "111010001101nnnntttt111111001111") // v8
+INST(thumb32_LDAEXH,         "LDAEXH",                   "111010001101nnnntttt111111011111") // v8
+INST(thumb32_LDAEXD,         "LDAEXD",                   "111010001101nnnnttttuuuu11111111") // v8
+INST(thumb32_STLB,           "STLB",                     "111010001100nnnntttt111110001111") // v8
+INST(thumb32_STLH,           "STLH",                     "111010001100nnnntttt111110011111") // v8
+INST(thumb32_STLEX,          "STLEX",                    "111010001100nnnntttt11111110dddd") // v8
+INST(thumb32_STLEXB,         "STLEXB",                   "111010001100nnnntttt11111100dddd") // v8
+INST(thumb32_STLEXH,         "STLEXH",                   "111010001100nnnntttt11111101dddd") // v8
+INST(thumb32_STLEXD,         "STLEXD",                   "111010001100nnnnttttuuuu1111dddd") // v8
 INST(thumb32_STREXB,         "STREXB",                   "111010001100nnnntttt11110100dddd")
 INST(thumb32_STREXH,         "STREXH",                   "111010001100nnnntttt11110101dddd")
 INST(thumb32_STREXD,         "STREXD",                   "111010001100nnnnttttuuuu0111dddd")
@@ -251,6 +266,11 @@ INST(thumb32_RBIT,           "RBIT",                     "111110101001nnnn1111dd
 INST(thumb32_REVSH,          "REVSH",                    "111110101001nnnn1111dddd1011mmmm")
 INST(thumb32_SEL,            "SEL",                      "111110101010nnnn1111dddd1000mmmm")
 INST(thumb32_CLZ,            "CLZ",                      "111110101011nnnn1111dddd1000mmmm")
+// ARMv8-A CRC32 checksum instructions. The ARM-state equivalents are arm_CRC32/arm_CRC32C;
+// the Thumb-2 form carries no condition field of its own (an enclosing IT block supplies it)
+// and encodes the element size in zz.
+INST(thumb32_CRC32,          "CRC32",                    "111110101100nnnn1111dddd10zzmmmm") // v8
+INST(thumb32_CRC32C,         "CRC32C",                   "111110101101nnnn1111dddd10zzmmmm") // v8
 
 // Multiply, Multiply Accumulate, and Absolute Difference
 INST(thumb32_MUL,            "MUL",                      "111110110000nnnn1111dddd0000mmmm")
