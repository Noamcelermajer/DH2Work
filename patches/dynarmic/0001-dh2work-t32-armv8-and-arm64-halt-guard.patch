+    bool thumb32_CRC32(Reg n, Reg d, Imm<2> sz, Reg m);
+    bool thumb32_CRC32C(Reg n, Reg d, Imm<2> sz, Reg m);
 
     // Data processing instructions
     bool arm_ADC_imm(Cond cond, bool S, Reg n, Reg d, int rotate, Imm<8> imm8);
@@ -496,6 +498,18 @@ struct TranslatorVisitor final {
 
     // thumb32 load/store dual, load/store exclusive, table branch instructions
     bool thumb32_LDA(Reg n, Reg t);
+    bool thumb32_LDAB(Reg n, Reg t);
+    bool thumb32_LDAH(Reg n, Reg t);
+    bool thumb32_LDAEX(Reg n, Reg t);
+    bool thumb32_LDAEXB(Reg n, Reg t);
+    bool thumb32_LDAEXH(Reg n, Reg t);
+    bool thumb32_LDAEXD(Reg n, Reg t, Reg t2);
+    bool thumb32_STLB(Reg n, Reg t);
+    bool thumb32_STLH(Reg n, Reg t);
+    bool thumb32_STLEX(Reg n, Reg t, Reg d);
+    bool thumb32_STLEXB(Reg n, Reg t, Reg d);
+    bool thumb32_STLEXH(Reg n, Reg t, Reg d);
+    bool thumb32_STLEXD(Reg n, Reg t, Reg t2, Reg d);
     bool thumb32_LDRD_imm_1(bool U, Reg n, Reg t, Reg t2, Imm<8> imm8);
     bool thumb32_LDRD_imm_2(bool U, bool W, Reg n, Reg t, Reg t2, Imm<8> imm8);
     bool thumb32_LDRD_lit_1(bool U, Reg t, Reg t2, Imm<8> imm8);
diff --git a/src/dynarmic/frontend/A32/translate/impl/thumb32_crc32.cpp b/src/dynarmic/frontend/A32/translate/impl/thumb32_crc32.cpp
new file mode 100644
index 00000000..9be749f5
--- /dev/null
+++ b/src/dynarmic/frontend/A32/translate/impl/thumb32_crc32.cpp
@@ -0,0 +1,77 @@
+/* This file is part of the dynarmic project.
+ * Copyright (c) 2019 MerryMage
+ * SPDX-License-Identifier: 0BSD
+ */
+
+#include <mcl/assert.hpp>
+
+#include "dynarmic/frontend/A32/translate/impl/a32_translate_impl.h"
+
+namespace Dynarmic::A32 {
+namespace {
+
+// Thumb-2 CRC32 / CRC32C.
+//
+// The ARMv8-A CRC32 family computes an accumulation of the bytes of Rm through a polynomial
+// held in Rn. The ARM-state forms (arm_CRC32/arm_CRC32C, a32_crc32.cpp) carry a condition in
+// the encoding; the Thumb-2 forms are unconditional instructions placed in the
+// data-processing (register) space and take their predicate from an enclosing IT block.
+// translate_thumb.cpp resolves the Thumb condition before it consults the decoder, so the
+// semantic condition reached here is always AL.
+//
+// The size field selects one byte, one halfword or one word of Rm. sz == 0b11 and the use of
+// PC as any of the three registers are constrained UNPREDICTABLE; both are reported to the
+// callback rather than being assigned an implementation-defined meaning.
+
+enum class Crc32Polynomial {
+    Iso,         // CRC32B / CRC32H / CRC32W   (ISO 3309, shared with zlib and Ethernet)
+    Castagnoli,  // CRC32CB / CRC32CH / CRC32CW (Castagnoli / iSCSI)
+};
+
+bool TranslateThumbCRC32(TranslatorVisitor& visitor, Crc32Polynomial polynomial, Reg n, Reg d, Imm<2> sz, Reg m) {
+    if (n == Reg::PC || d == Reg::PC || m == Reg::PC) {
+        return visitor.UnpredictableInstruction();
+    }
+    if (sz == 0b11) {
+        return visitor.UnpredictableInstruction();
+    }
+
+    const IR::U32 accumulator = visitor.ir.GetRegister(n);
+    const IR::U32 data = visitor.ir.GetRegister(m);
+    const bool use_castagnoli = polynomial == Crc32Polynomial::Castagnoli;
+
+    IR::U32 result = accumulator;
+    switch (sz.ZeroExtend()) {
+    case 0b00:
+        result = use_castagnoli ? visitor.ir.CRC32Castagnoli8(accumulator, data)
+                                : visitor.ir.CRC32ISO8(accumulator, data);
+        break;
+    case 0b01:
+        result = use_castagnoli ? visitor.ir.CRC32Castagnoli16(accumulator, data)
+                                : visitor.ir.CRC32ISO16(accumulator, data);
+        break;
+    case 0b10:
+        result = use_castagnoli ? visitor.ir.CRC32Castagnoli32(accumulator, data)
+                                : visitor.ir.CRC32ISO32(accumulator, data);
+        break;
+    default:
+        UNREACHABLE();
+    }
+
+    visitor.ir.SetRegister(d, result);
+    return true;
+}
+
+}  // Anonymous namespace
+
+// CRC32{B,H,W} <Rd>, <Rn>, <Rm> (T1 encoding)
+bool TranslatorVisitor::thumb32_CRC32(Reg n, Reg d, Imm<2> sz, Reg m) {
+    return TranslateThumbCRC32(*this, Crc32Polynomial::Iso, n, d, sz, m);
+}
+
+// CRC32C{B,H,W} <Rd>, <Rn>, <Rm> (T1 encoding)
+bool TranslatorVisitor::thumb32_CRC32C(Reg n, Reg d, Imm<2> sz, Reg m) {
+    return TranslateThumbCRC32(*this, Crc32Polynomial::Castagnoli, n, d, sz, m);
+}
+
+}  // namespace Dynarmic::A32
diff --git a/src/dynarmic/frontend/A32/translate/impl/thumb32_load_store_dual.cpp b/src/dynarmic/frontend/A32/translate/impl/thumb32_load_store_dual.cpp
index 17d4285c..e842c88f 100644
--- a/src/dynarmic/frontend/A32/translate/impl/thumb32_load_store_dual.cpp
+++ b/src/dynarmic/frontend/A32/translate/impl/thumb32_load_store_dual.cpp
@@ -136,6 +136,150 @@ bool TranslatorVisitor::thumb32_LDA(Reg n, Reg t) {
     return true;
 }
 
+// ARMv8-A acquire/release and exclusive acquire/release accesses.
+//
+// The non-exclusive forms (LDAB, LDAH, STLB, STLH) transfer data with an ordered access so
+// that the load observes, and the store is observed by, the surrounding program order. The
+// exclusive forms additionally consult the global exclusive monitor through
+// ExclusiveReadMemory*/ExclusiveWriteMemory*, which is also what enforces the ordering. A
+// status register that aliases the address register or the data register, or a PC operand,
+// is UNPREDICTABLE rather than UNDEFINED.
+
+bool TranslatorVisitor::thumb32_LDAB(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(t, ir.ZeroExtendToWord(ir.ReadMemory8(base, IR::AccType::ORDERED)));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_LDAH(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(t, ir.ZeroExtendToWord(ir.ReadMemory16(base, IR::AccType::ORDERED)));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_LDAEX(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(t, ir.ExclusiveReadMemory32(base, IR::AccType::ORDERED));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_LDAEXB(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(t, ir.ZeroExtendByteToWord(ir.ExclusiveReadMemory8(base, IR::AccType::ORDERED)));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_LDAEXH(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(t, ir.ZeroExtendHalfToWord(ir.ExclusiveReadMemory16(base, IR::AccType::ORDERED)));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_LDAEXD(Reg n, Reg t, Reg t2) {
+    if (t == Reg::PC || t2 == Reg::PC || n == Reg::PC || t == t2) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    const auto [lo, hi] = ir.ExclusiveReadMemory64(base, IR::AccType::ORDERED);
+    // The low-addressed word is the first destination; do not reorder these in big-endian mode.
+    ir.SetRegister(t, lo);
+    ir.SetRegister(t2, hi);
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_STLB(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.WriteMemory8(base, ir.LeastSignificantByte(ir.GetRegister(t)), IR::AccType::ORDERED);
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_STLH(Reg n, Reg t) {
+    if (t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.WriteMemory16(base, ir.LeastSignificantHalf(ir.GetRegister(t)), IR::AccType::ORDERED);
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_STLEX(Reg n, Reg t, Reg d) {
+    if (d == Reg::PC || t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+    if (d == n || d == t) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(d, ir.ExclusiveWriteMemory32(base, ir.GetRegister(t), IR::AccType::ORDERED));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_STLEXB(Reg n, Reg t, Reg d) {
+    if (d == Reg::PC || t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+    if (d == n || d == t) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(d, ir.ExclusiveWriteMemory8(base, ir.LeastSignificantByte(ir.GetRegister(t)), IR::AccType::ORDERED));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_STLEXH(Reg n, Reg t, Reg d) {
+    if (d == Reg::PC || t == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+    if (d == n || d == t) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(d, ir.ExclusiveWriteMemory16(base, ir.LeastSignificantHalf(ir.GetRegister(t)), IR::AccType::ORDERED));
+    return true;
+}
+
+bool TranslatorVisitor::thumb32_STLEXD(Reg n, Reg t, Reg t2, Reg d) {
+    if (d == Reg::PC || t == Reg::PC || t2 == Reg::PC || n == Reg::PC) {
+        return UnpredictableInstruction();
+    }
+    if (d == n || d == t || d == t2) {
+        return UnpredictableInstruction();
+    }
+
+    const IR::U32 base = ir.GetRegister(n);
+    ir.SetRegister(d, ir.ExclusiveWriteMemory64(base, ir.GetRegister(t), ir.GetRegister(t2), IR::AccType::ORDERED));
+    return true;
+}
+
 bool TranslatorVisitor::thumb32_LDRD_imm_1(bool U, Reg n, Reg t, Reg t2, Imm<8> imm8) {
     return LoadDualImmediate(*this, false, U, true, n, t, t2, imm8);
 }
