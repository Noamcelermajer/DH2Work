+    const std::uint64_t rounded = page_round_up(len);
+    if (!range_valid(addr, rounded)) return false;
+    const std::uint64_t end_page = (static_cast<std::uint64_t>(addr) + rounded) >> 12;
+    for (std::uint64_t page = addr >> 12; page < end_page; ++page) {
+        if (backing_[page] != kBackingPrivateAnonymous) return false;
+    }
+    return true;
