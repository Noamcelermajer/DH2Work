+bool GuestMemory::ensure_coarse_backing(std::uint32_t addr, std::uint64_t len) {
+    const std::uint64_t mask = host_page_size_ - 1;
+    const std::uint64_t first = static_cast<std::uint64_t>(addr) & ~mask;
+    const std::uint64_t end = (static_cast<std::uint64_t>(addr) + len + mask) & ~mask;
+    std::vector<std::uint64_t> created;
+    for (std::uint64_t chunk = first; chunk < end; chunk += host_page_size_) {
+        if (coarse_chunk_has_guest_pages(chunk)) continue;
+        void* p = mmap(base_ + chunk, host_page_size_, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+        if (p != MAP_FAILED) {
+            created.push_back(chunk);
+            continue;
+        }
+        const int error = errno;
+        for (const std::uint64_t fresh : created) {
+            mmap(base_ + fresh, host_page_size_, PROT_NONE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0);
+        }
+        errno = error;
+        return false;
+    }
+    return true;
+}
