+bool GuestMemory::coarse_chunk_has_guest_pages(std::uint64_t chunk) const {
+    const std::uint64_t first = chunk >> 12;
+    for (std::uint64_t i = first; i < first + (host_page_size_ >> 12); ++i) {
+        if (pages_[i] & kPageMapped) return true;
+    }
+    return false;
+}
