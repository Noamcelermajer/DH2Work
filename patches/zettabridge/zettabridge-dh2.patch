--- a/core/android/zbridge_jni.cpp
+++ b/core/android/zbridge_jni.cpp
@@ -124,2 +124,20 @@ JNIEXPORT void JNICALL Java_com_zettabridge_core_ZBridge_activatePlugin(JNIEnv*
 
+// Configure aliases before guest code starts; both prefixes must be absolute directories.
+JNIEXPORT void JNICALL Java_com_zettabridge_core_ZBridge_addPathAlias(JNIEnv* env, jclass,
+                                                                    jstring guest, jstring host) {
+    const auto g = to_string(env, guest);
+    const auto h = to_string(env, host);
+    if (!g || !h || g->empty() || h->empty() || g->front() != '/' || h->front() != '/' ||
+        g->back() != '/' || h->back() != '/') {
+        throw_new(env, "java/lang/IllegalArgumentException", "Path aliases require absolute directory prefixes");
+        return;
+    }
+    auto* runtime = zb::GuestJniRuntime::peek();
+    if (runtime == nullptr) {
+        throw_new(env, "java/lang/IllegalStateException", "Activate the plugin before adding path aliases");
+        return;
+    }
+    runtime->add_path_alias(*g, *h);
+}
