+    // These are candidates found on the stack, NOT an unwound backtrace.
+    unsigned candidates = 0;
+    for (unsigned offset = 0; offset < 1024 && candidates < 16; offset += 4) {
+        const std::uint64_t addr = static_cast<std::uint64_t>(sp) + offset;
+        if (addr > UINT32_MAX || !mem_.accessible(addr, 4, kPageRead)) break;
+        std::uint32_t value;
+        std::memcpy(&value, mem_.host_ptr(addr, 4, kPageRead), 4);
+        if (!mem_.accessible(value & ~1u, 2, kPageExec)) continue;
+        const std::string module = describe_address(value & ~1u);
+        if (module == "?") continue;
+        char slot[64];
+        std::snprintf(slot, sizeof slot, "sp+0x%x=0x%08x ", offset, value);
+        runtime_report().note_crash_detail("stack-candidate-" + std::to_string(++candidates), slot + module);
+    }
 }
