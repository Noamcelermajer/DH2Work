# ---------------------------------------------------------------------------
# Private inputs and build outputs.
# DH2Work ships source, patches, tests, evidence and docs only.  The original
# game APK, the complete game cache, toolchains, downstream checkouts, signing
# material and generated packages must never be committed here.
# ---------------------------------------------------------------------------

# Original game / guest packages and generated wrappers
*.apk
game-unsigned.apk

# Owner-supplied cache and the prebuilt translator bundle
cache.zip
runtime-bundle.zip

# Signing material (the documented local key is a development fixture only)
*.p12
*.keystore
*.jks

# Downloaded tools and generated output
downloads/
out/
deliverables/

# Toolchains and SDKs
android-sdk/
toolchains/

# Downstream upstream checkout (ZettaBridge), restored locally per the build docs
research/ZettaBridge/

# Python bytecode caches
__pycache__/
*.pyc
